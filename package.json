{
  "name": "claude-mcp-audit",
  "version": "0.1.0",
  "description": "Read-only operational audit and Markdown report generator for Claude Code and MCP workspaces",
  "type": "module",
  "bin": {
    "claude-mcp-audit": "./audit.mjs",
    "claude-mcp-report": "./report.mjs",
    "claude-mcp-new-workflow": "./new-workflow.mjs",
    "claude-mcp-estimate-scope": "./estimate-scope.mjs"
  },
  "files": [
    "audit.mjs",
    "report.mjs",
    "README.md",
    "workflow-contract.md",
    "example-audit.md",
    "new-workflow.mjs",
    "workflow-template.md",
    "estimate-scope.mjs",
    "implementation-scope.md",
    "examples/appointment-intake.md",
    "examples/appointment-intake.test.mjs",
    ".claude-plugin/plugin.json",
    "skills/auditing-mcp-workflows/SKILL.md",
    "skills/auditing-mcp-workflows/evals.json",
    "skills/auditing-mcp-workflows/references/workflow-contract.md",
    "skills/auditing-mcp-workflows/references/appointment-intake.md",
    "skills/auditing-mcp-workflows/scripts/audit.mjs",
    "plugin.test.mjs",
    "acquisition-baseline.mjs",
    "LICENSE",
    "validate-plugin.mjs",
    "examples/trades-operations-assistant.md",
    ".claude-plugin/marketplace.json",
    "capabilities.json"
  ],
  "scripts": {
    "audit": "node audit.mjs .",
    "report": "node report.mjs .",
    "test": "node validate-plugin.mjs && node test.mjs && node examples/appointment-intake.test.mjs && node plugin.test.mjs",
    "new-workflow": "node new-workflow.mjs",
    "estimate-scope": "node estimate-scope.mjs",
    "acquisition-baseline": "node acquisition-baseline.mjs",
    "validate-plugin": "node validate-plugin.mjs"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "audit",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OssaBellator/claude-mcp-workflow-audit.git"
  },
  "homepage": "https://ossabellator.github.io/claude-mcp-workflow-audit/",
  "engines": {
    "node": ">=20"
  }
}
